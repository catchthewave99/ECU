# Acceptance limits for the Stage 1 (SIL) and Stage 2 (HIL) test cases.
#
# This file is the single source of truth for every tolerance band. Both the SIL
# suite (tests/sil/run_sil_suite.sh) and the HIL procedures in
# docs/05-stage2-hil-ni-plan.md read their limits from here, so a HIL finding that
# widens or tightens a band is one reviewable change that both stages inherit -
# no test code is rewritten. See docs/09-change-control.md.
#
# Format: shell assignments, values in the unit named by the variable.

# TC-SIL/HIL-02  engine state machine
STATE_SETTLE_MS=2000            # crank rotating -> state IDLE within this time
RPM_1200_MIN=1150
RPM_1200_MAX=1250

# TC-SIL/HIL-03  base injection pulse vs CHT look-up table
PULSE_81C_MIN=2780              # baseInt row 80 degC = 2800 us
PULSE_81C_MAX=2830
PULSE_22C_MIN=3380              # baseInt row 20 degC = 3400 us
PULSE_22C_MAX=3430

# TC-SIL/HIL-04  speed measurement
STIMULUS_SPEED_TOL_PCT=1        # crank generator vs commanded speed
ECU_SPEED_TOL_PCT=3             # ECU-reported rpm vs crank generator, after settling
SPEED_SETTLE_CYCLES=40          # RPMFilter is 5 % per TDC event

# TC-SIL/HIL-05  injection phasing at 2000 rpm, 30 deg advance (2500 us nominal)
PHASE_2000RPM_MIN=2350
PHASE_2000RPM_MAX=2510

# TC-SIL/HIL-07  injector duration guard
PULSE_ABS_MAX_US=8000           # INJ_MAX_US in uno_baseline
PULSE_COUNT_MIN=150             # 6 s at 2000 rpm, minus start-up transient
PULSE_COUNT_MAX=220

# TC-SIL/HIL-08  start enrichment (interval x 1.25 while STARTING)
PULSE_ENRICH_MIN=3450           # 2800 us x 1.25 = 3500 us
PULSE_ENRICH_MAX=3550
