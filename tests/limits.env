# Acceptance limits for the Uno ECU bench.
#
# This file is the only place a number lives. The SIL suite
# (tests/sil/run_sil_suite.sh) and the HIL sequence (tests/hil/ni_sequence.py)
# both read it, so a change here is one reviewable change that both stages
# inherit, and no test code has to be rewritten.
#
# Format: shell assignments, values in the unit named by the variable.
#
# These limits were frozen before the three functions were consolidated onto
# one board. Consolidation is not allowed to change them: that is the point of
# the experiment. See docs/06-traceability-matrix.md.

# ---- Safety: hazard warning (REQ-SAFE-100) --------------------------------
# From the hazard switch closing to the first hazard lamp lighting. This is the
# one limit that is not a tradeoff.
HAZARD_RESPONSE_MAX_MS=100
HAZARD_PRESS_COUNT=8            # presses per test; every one must pass

# ---- Thermal control ------------------------------------------------------
FAN_ON_C=95                     # fan runs at or above this
FAN_OFF_C=90                    # fan stops at or below this
OVERTEMP_C=105                  # warning lamp at or above this
TEMP_REPORT_TOL_C=2             # reported temperature vs commanded temperature
TEMP_STIM_MARGIN_C=1            # drive this far past a switching point when
                                # testing it, to clear the ADC's resolution

# ---- Body control: turn-signal flasher ------------------------------------
# A lamp is on for a half period, then off for a half period.
FLASH_HALF_MS_MIN=330
FLASH_HALF_MS_MAX=370

# ---- Scheduling -----------------------------------------------------------
# The slowest single pass of loop(). It bounds how late any job can be, which
# is why the hazard limit above is achievable at all.
LOOP_MAX_MS=20
